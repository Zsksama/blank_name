# 根目录只跟踪 Git 忽略规则和 Godot 游戏项目。
/*
!/.gitignore
!/开源游戏-v-0.1/

# Operating system metadata
.DS_Store
._*
Thumbs.db
Desktop.ini

# Machine-specific Codex MCP configuration
/.codex/config.toml

# Godot 4 editor and import cache, including local export credentials
.godot/

# Python bytecode from repository scripts
__pycache__/
*.pyc

#本地配置文件等
/.local
